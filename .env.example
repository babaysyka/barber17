# Local Postgres from `docker compose up -d` (port 54322).
# Supabase: Project Settings → Database.
# DATABASE_URL is the pooler (port 6543). DIRECT_URL is the direct connection (port 5432) used by Prisma migrations.
DATABASE_URL="postgresql://orda:orda@localhost:54322/orda?schema=public"
DIRECT_URL="postgresql://orda:orda@localhost:54322/orda?schema=public"

# Supabase: Project Settings → API. Server only. Never send the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# BotFather token. Server only. Verifies Mini App initData and sends bot messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_MINI_APP_URL=

# Shared by the API route and the Supabase notifications function. Not a browser secret.
CRON_SECRET=

# HMAC secret for the admin session cookie. Server only.
ADMIN_SESSION_SECRET=

# API. The site reads API_URL on the server. Default in code is http://localhost:4000.
# Vercel injects PORT. Put real secrets in the Vercel project environment, not in git.
API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
